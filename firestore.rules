rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Koleksi sensor_readings: pembacaan dan pengiriman data suhu dari ESP32 & web dashboard
    match /sensor_readings/{readingId} {
      allow read, create: if true;
      allow update, delete: if false; // Menjaga integritas data log suhu
    }

    // Koleksi device_settings: hanya user yang login (pemilik, via dashboard web)
    // yang boleh mengubah pengaturan perangkat jarak jauh. ESP32 hanya membaca.
    match /device_settings/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
